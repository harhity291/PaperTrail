# Copy this file to backend/.env and fill it in. Never commit .env (it is in .gitignore).
#
# PaperTrail works with any LLM that has an OpenAI-compatible API.
# Leave LLM_MODEL empty and /ask still works: it returns the best-matching
# passages from the PDF instead of a written answer.

# Option 1 - Groq (fast; get a key at https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Option 2 - Ollama on your own laptop (free, no key; first run: ollama pull llama3.2)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2
