# Copy this file to backend/.env and fill it in. Never commit .env (it is in .gitignore).
#
# PaperTrail works with any LLM that has an OpenAI-compatible API.
# Leave LLM_MODEL empty and /ask still works: it returns the best-matching
# passages from the PDF instead of a written answer.
# Restart the server (Ctrl+C, then python run.py) after changing this file.

# Option 1 - Grok by xAI (the team's key). Create a key at https://console.x.ai -> API Keys.
# The key starts with "xai-" and is shown only once when you create it.
# The ID in the key list (looks like 1234abcd-....) is NOT the key.
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-4.7

# Option 2 - Groq (keys start with gsk_; get one at https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# Option 3 - Ollama on your own laptop (free, no key; first run: ollama pull llama3.2)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2
